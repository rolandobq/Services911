<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ticket_card"
    android:orientation="horizontal"
    android:padding="0dp">

    <View
        android:id="@+id/ticketSideBar"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#E5484D" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTicketIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/chip_soft"
                android:gravity="center"
                android:text="♡"
                android:textColor="#168DCE"
                android:textSize="23sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtTicketPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_danger_soft"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="ALTA"
                android:textColor="#D94C5C"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtTicketService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Paro cardíaco"
            android:textColor="#203746"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTicketId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Ticket #000124"
            android:textColor="#8395A2"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtTicketBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="4"
            android:lineSpacingExtra="4dp"
            android:text="Persona afectada: Usuario&#10;Ubicación: Guadalajara, Jalisco"
            android:textColor="#607D8B"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#E9EFF3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTicketAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ver y administrar ›"
                android:textColor="#168DCE"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTicketStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● En camino"
                android:textColor="#22A06B"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
